SECRET_KEY=replace-with-a-long-random-secret
# Local development uses SQLite. MySQL example:
# DATABASE_URL=mysql+pymysql://USER:PASSWORD@HOST:3306/carematch
DATABASE_URL=sqlite:///carematch.db

# Optional Azure OpenAI: the app uses a local, explainable similarity fallback until configured.
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/
AZURE_OPENAI_API_KEY=your-key
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-02-01
